# Used by Prisma CLI commands run from the repo root (db:generate, db:migrate:dev,
# db:seed, db:studio). This must be the DB owner/superuser connection (migrations
# run DDL) — never the least-privilege edumanage_app role apps/api and
# apps/worker use, and never committed with a real password.
DATABASE_URL=postgresql://edumanage:edumanage@localhost:5432/edumanage_dev
