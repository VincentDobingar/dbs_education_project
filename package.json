{
  "name": "edumanage-africa",
  "private": true,
  "version": "0.1.0",
  "description": "EduManage Africa - Plateforme SaaS multitenant de gestion des etablissements d'enseignement en Afrique",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepare": "husky",
    "db:generate": "prisma generate --schema=./prisma/schema",
    "db:migrate:dev": "prisma migrate dev --schema=./prisma/schema",
    "db:seed": "tsx prisma/seed/index.ts",
    "db:seed:demo": "tsx prisma/seed/demo/demo-school.ts",
    "db:seed:basics": "node --env-file=.env --import tsx prisma/seed/school-basics.ts",
    "db:seed:test-families": "node --env-file=.env --import tsx prisma/seed/test-families.ts",
    "db:seed:test-follow-up": "node --env-file=.env --import tsx prisma/seed/test-follow-up.ts",
    "db:seed:activate-test-portals": "node --env-file=.env --import tsx prisma/seed/activate-test-portals.ts",
    "db:seed:test-student-accounts": "node --env-file=.env --import tsx prisma/seed/test-student-accounts.ts",
    "db:seed:test-complete-dashboard": "node --env-file=.env --import tsx prisma/seed/test-complete-dashboard.ts",
    "pricing:snapshot": "tsx prisma/seed/export-pricing-snapshot.ts && prettier --write apps/web/src/content/pricing-snapshot.json",
    "db:seed:typecheck": "tsc --noEmit -p prisma/tsconfig.json",
    "db:studio": "prisma studio --schema=./prisma/schema"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "@edumanage/tsconfig": "workspace:*",
    "@types/node": "^22.10.1",
    "turbo": "^2.3.0",
    "prettier": "^3.4.0",
    "prisma": "^6.1.0",
    "rimraf": "^6.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed/index.ts"
  }
}
