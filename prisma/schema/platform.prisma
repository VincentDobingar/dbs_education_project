// Referentiels globaux (Country, Currency) et modele tenant (§2, §14 du cahier des charges).
// Tenant est la racine de l'isolation multitenant : toute table metier porte un tenantId
// qui pointe, directement ou indirectement, vers Tenant.id.

enum TenantOwnershipType {
  PUBLIC
  PRIVATE
}

enum TenantStatus {
  DRAFT
  PENDING_VERIFICATION
  VERIFIED
  TRIAL
  ACTIVE
  SUSPENDED
  EXPIRED
  REJECTED
  CANCELLED
}

/// Régions de l'Union africaine (regroupement des pays dans les listes).
enum CountryRegion {
  CENTRAL_AFRICA
  EAST_AFRICA
  NORTH_AFRICA
  SOUTHERN_AFRICA
  WEST_AFRICA
}

model Country {
  id                String         @id @default(cuid())
  isoCode           String         @unique // ISO 3166-1 alpha-2, ex: CM, KE, CI
  isoAlpha3         String?        @unique // ISO 3166-1 alpha-3, ex: CMR, KEN, CIV
  region            CountryRegion?
  nameFr            String
  nameEn            String
  phoneCallingCode  String
  defaultCurrencyId String?
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  defaultCurrency Currency? @relation(fields: [defaultCurrencyId], references: [id])
  tenants         Tenant[]

  @@index([isActive])
}

model Currency {
  id            String   @id @default(cuid())
  isoCode       String   @unique // ISO 4217, ex: XAF, XOF, KES, USD
  nameFr        String
  nameEn        String
  symbol        String
  decimalDigits Int      @default(2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  countriesDefaultingHere Country[]
  tenants                 Tenant[]
  planPrices              PlanPrice[]

  @@index([isActive])
}

model Tenant {
  id              String              @id @default(cuid())
  name            String
  legalName       String?
  logoUrl         String?
  colorPrimary    String?
  colorSecondary  String?
  ownershipType   TenantOwnershipType
  licenseNumber   String? // numero d'agrement / autorisation
  countryId       String
  region          String?
  city            String?
  address         String?
  phone           String?
  email           String?
  timezone        String              @default("Africa/Douala")
  currencyId      String
  status          TenantStatus        @default(DRAFT)
  verifiedAt      DateTime?
  suspendedAt     DateTime?
  suspendedReason String?
  deletedAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  country  Country  @relation(fields: [countryId], references: [id])
  currency Currency @relation(fields: [currencyId], references: [id])

  domains           TenantDomain[]
  settings          TenantSetting[]
  campuses          Campus[]
  memberships       TenantMembership[]
  auditLogs         AuditLog[]
  subscriptionOwner SubscriptionOwner?

  academicYears   AcademicYear[]
  educationCycles EducationCycle[]
  gradeLevels     GradeLevel[]
  programs        Program[]
  departments     Department[]
  classrooms      Classroom[]
  subjects        Subject[]
  assessmentTypes AssessmentType[]
  students        Student[]
  employees       Employee[]
  feeCategories   FeeCategory[]

  @@index([status])
  @@index([countryId])
}

model TenantDomain {
  id         String    @id @default(cuid())
  tenantId   String
  subdomain  String    @unique // ex: lycee-excellence -> lycee-excellence.edumanage.africa
  isPrimary  Boolean   @default(true)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Stockage cle/valeur des parametres d'etablissement (regles de notation, quotas
/// d'affichage, preferences...) pour rester extensible sans migration a chaque nouveau
/// parametre. Les parametres structurels (annee scolaire, devise) restent des colonnes
/// typees sur Tenant.
model TenantSetting {
  id          String   @id @default(cuid())
  tenantId    String
  key         String
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
}

/// §31 "parametres globaux" : meme forme cle/valeur que TenantSetting (extensible
/// sans migration a chaque nouveau parametre : duree d'essai par defaut, contact
/// support, message de maintenance...), mais sans ancrage a un tenant (portee
/// plateforme, jamais scopee). Ce n'est volontairement PAS un TenantSetting avec
/// tenantId nul : un `@@unique([tenantId, key])` degenererait (Postgres traite
/// deux NULL comme non egaux dans un index unique, cf. le meme piege deja gere
/// pour MessageTemplate) — `key` porte donc directement sa propre contrainte
/// unique ici.
model PlatformSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?
}

model Campus {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  code      String
  address   String?
  city      String?
  phone     String?
  email     String?
  isMain    Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classrooms  Classroom[]
  enrollments Enrollment[]
  rooms       Room[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

/// §17 : nature d'un élément du catalogue de référence (CatalogItem).
enum CatalogKind {
  EDUCATION_CYCLE
  GRADE_LEVEL
  SUBJECT
  ASSESSMENT_TYPE
  FEE_CATEGORY
  CAMPUS
  ROOM
  /// Jour férié à date fixe d'un pays (countryIsoCode + month/day).
  HOLIDAY
}

/// Catalogue de référence global, partagé par tous les établissements : listes de
/// choix proposées dans Configuration (cycles, niveaux, matières, types
/// d'évaluation, catégories de frais) pour éviter une saisie complète. Un
/// établissement en IMPORTE des éléments (copie dans ses propres tables
/// tenant-scoped — EducationCycle, GradeLevel, Subject, AssessmentType,
/// FeeCategory), jamais de lien vivant : le modifier ensuite ne change rien chez
/// les établissements qui l'ont déjà importé. Pas de tenantId, donc ni RLS ni garde
/// tenant (comme Country/Currency). Maintenu par la super-administration.
model CatalogItem {
  id             String      @id @default(cuid())
  kind           CatalogKind
  code           String
  nameFr         String
  nameEn         String
  order          Int         @default(0)
  /// GRADE_LEVEL uniquement : code du cycle parent (CatalogItem de kind EDUCATION_CYCLE).
  parentCode     String?
  /// HOLIDAY uniquement : pays concerné (ISO 3166-1 alpha-2) et date fixe (mois 1-12, jour 1-31).
  /// Les fêtes à date mobile (Pâques, Aïd…) restent saisies par l'établissement.
  countryIsoCode String?
  month          Int?
  day            Int?
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([kind, code])
  @@index([kind, isActive])
  @@index([kind, countryIsoCode])
}
