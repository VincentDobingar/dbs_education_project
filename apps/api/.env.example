# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Least-privilege role (never the DB owner/superuser — Row-Level Security is
# silently bypassed for superusers). See docker/init-db/01-create-app-role.sh.
DATABASE_URL=postgresql://edumanage_app:change-me-before-first-up@localhost:5432/edumanage_dev
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Generate with: openssl rand -hex 32 (must be exactly 64 hex chars / 32 bytes, AES-256)
MFA_ENCRYPTION_KEY=
# "false" rend le MFA facultatif pour les rôles sensibles (obligatoire par défaut)
MFA_REQUIRED_FOR_SENSITIVE_ROLES=true
DEV_SKIP_MFA=false

# Optional (§28). Leave all blank to keep the current behavior: verification
# tokens/codes and activation codes are only returned in the API response, nothing
# is actually sent. Fill in every SMTP_* var below to send real emails (any SMTP
# server works — Gmail with an app password, your hosting provider, Mailtrap for a
# sandbox). SMTP_SECURE=true for port 465 (TLS direct), false or empty for
# STARTTLS on port 587 (e.g. Brevo: smtp-relay.brevo.com, port 587).
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# Optional. Brevo HTTP API instead of SMTP, for hosts that block outbound SMTP
# ports (Railway outside the Pro plan: SMTP fails with "Connection timeout").
# Takes priority over SMTP when set. API key from Brevo > SMTP & API > API keys
# (starts with xkeysib-, not the SMTP key). Sender: EMAIL_FROM_ADDRESS, or
# SMTP_FROM_ADDRESS when empty — it must be a sender verified in Brevo.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=EduManage Africa

# Optional (§28). Leave all blank to skip real SMS delivery. Fill in every TWILIO_*
# var below (from https://console.twilio.com) to send real SMS via Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional. Konoom (Chad, Cameroon) mobile payments, provided by Konoom once the
# partnership is signed. All four are required to enable providers KONOOM_TD and
# KONOOM_CM; the webhook URL to give Konoom is
# <PUBLIC_API_URL>/api/v1/payments/webhooks/KONOOM_TD (or KONOOM_CM).
KONOOM_API_BASE_URL=
KONOOM_API_KEY=
KONOOM_MERCHANT_ID=
KONOOM_WEBHOOK_SECRET=
