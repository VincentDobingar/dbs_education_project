# Modèle des variables de production pour docker/docker-compose.prod.yml.
# Copier vers docker/.env.production (gitignoré) pour un `docker compose` manuel,
# ou saisir ces valeurs dans l'interface Coolify. Ne jamais commiter de vraies valeurs.
#
# Mots de passe : utiliser des valeurs hexadécimales (openssl rand -hex 24). Ils sont
# insérés tels quels dans des URL postgresql:// / redis:// — un caractère spécial
# (@ : / # %) les casserait.

# Origines publiques (sans slash final). WEB_URL = CORS de l'API ; API_URL est aussi
# incorporée au build du frontend (changer API_URL impose de reconstruire `web`).
WEB_URL=https://app.exemple.com
API_URL=https://api.exemple.com

# Compte propriétaire Postgres : migrations uniquement (openssl rand -hex 24)
POSTGRES_PASSWORD=
# Rôle applicatif sans BYPASSRLS, utilisé par l'API et le worker (openssl rand -hex 24).
# Lu uniquement à la première initialisation du volume Postgres : le changer ensuite
# ne modifie pas le rôle existant (ALTER ROLE edumanage_app PASSWORD '...' à la main).
APP_ROLE_PASSWORD=
REDIS_PASSWORD=

# openssl rand -base64 48 — deux valeurs distinctes, ≥ 32 caractères
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# openssl rand -hex 32 — exactement 64 caractères hex. NE PLUS CHANGER après mise en
# service : les secrets TOTP déjà chiffrés deviendraient illisibles.
MFA_ENCRYPTION_KEY=

# Canaux email/SMS : voir le bloc commenté du service `api` dans le compose.
