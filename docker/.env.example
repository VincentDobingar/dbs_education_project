# Only used to override docker-compose.yml defaults if needed locally.
POSTGRES_USER=edumanage
POSTGRES_PASSWORD=edumanage
POSTGRES_DB=edumanage_dev

# Password for the least-privilege edumanage_app role auto-created by
# docker/init-db/01-create-app-role.sh — this is what apps/api and apps/worker
# connect as (never as POSTGRES_USER, which is a superuser and bypasses RLS).
APP_ROLE_PASSWORD=change-me-before-first-up
